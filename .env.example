# ── Required ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/zyra
JWT_SECRET=your-jwt-secret-here

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000

# ── Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=Zyra <noreply@zyra.host>

# ── AI Vision (Hugging Face) — https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# ── ZYRA Eyes / VA / RVIA ───────────────────────────────────
# Simulation is the default. Do not set the native sentinel on servers or
# machines you do not own/control and explicitly authorize.
# ZYRA_EYES_NATIVE_CONTROL=I_OWN_AND_AUTHORIZE_THIS_MACHINE
# ZYRA_EYES_AUDIT_LOG=/absolute/path/to/api-audit.jsonl
# ZYRA_EYES_LOCAL_AUDIT=/absolute/path/to/native-audit.jsonl

# ── VA3LM / Palantir Foundry / EYERIS ───────────────────────
# Server-side only. Never expose FOUNDRY_TOKEN to browser code.
# FOUNDRY_BASE_URL=https://your-enrollment.palantirfoundry.com
# FOUNDRY_TOKEN=your-server-side-token
# EYERIS_ONTOLOGY=eyeris
# EYERIS_BASE_URL=http://localhost:8080

# ── Admin Bootstrap ──────────────────────────────────────────
BOOTSTRAP_SECRET=your-bootstrap-secret-here

# ── Replit (auto-set on Replit, needed for Stripe redirects) ──
# REPLIT_DOMAINS=your-app.replit.app

# ── Optional / Observability ─────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
# NODE_ENV=production
