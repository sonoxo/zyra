#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ZYRA_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

candidates=()
[[ -n "${GPT_DOUG_HOME:-}" ]] && candidates+=("$GPT_DOUG_HOME")
[[ -n "${ZYRA_GPT_DOUG_HOME:-}" ]] && candidates+=("$ZYRA_GPT_DOUG_HOME")
candidates+=(
  "$ZYRA_ROOT/../gpt-doug-llm"
  "$HOME/gpt-doug-llm"
  "$HOME/Developer/gpt-doug-llm"
  "$HOME/Documents/gpt-doug-llm"
  "$HOME/Desktop/gpt-doug-llm"
  "$HOME/.local/share/gpt-doug-llm"
)

DOUG_HOME=""
for candidate in "${candidates[@]}"; do
  if [[ -f "$candidate/agents/llm_backend.py" ]]; then
    DOUG_HOME="$(cd -- "$candidate" && pwd)"
    break
  fi
done

if [[ -z "$DOUG_HOME" ]]; then
  printf '%s\n' "ZYRA BRIDGE ERROR // gpt-doug-llm was not found." >&2
  printf '%s\n' "Install it at ~/gpt-doug-llm or set GPT_DOUG_HOME, then retry." >&2
  exit 127
fi

# Prefer the provider router, but make an already-installed local Ollama model
# immediately usable without requiring the user to rename it to 'gpt-doug'.
export GPT_DOUG_PROVIDER="${GPT_DOUG_PROVIDER:-auto}"
if command -v ollama >/dev/null 2>&1; then
  if ! curl -fsS --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    nohup ollama serve >"${TMPDIR:-/tmp}/zyra-ollama.log" 2>&1 &
    sleep 2
  fi
  if [[ -z "${OLLAMA_MODEL:-}" ]]; then
    first_model="$(ollama list 2>/dev/null | awk 'NR==2 {print $1; exit}')"
    [[ -n "$first_model" ]] && export OLLAMA_MODEL="$first_model"
  fi
fi

export ZYRA_PROMPT="${*:-}"
cd "$DOUG_HOME"
exec python3 - <<'PY'
import os

from agents import llm_backend

CYAN = "\033[96m"
RESET = "\033[0m"


def zyra_print(message: str) -> None:
    print(f"{CYAN}ZYRA > {message}{RESET}")


def provider_ready():
    state = llm_backend.health()
    ready = bool(state.get("configured") and state.get("model_available"))
    if not ready:
        provider = state.get("provider", "none")
        message = state.get("message", "No AI provider is ready")
        zyra_print(f"bridge connected; AI provider {provider!r} is not ready: {message}.")
        zyra_print("configure Gemini/OpenAI/Claude, or start Ollama with any installed model.")
    return ready


def ask(messages):
    try:
        chunks = []
        for event in llm_backend.chat_stream(messages, llm_backend.DEFAULT_MODEL, {}):
            text = event.get("message", {}).get("content", "")
            if text:
                chunks.append(text)
        return "".join(chunks).strip()
    except Exception as exc:
        zyra_print(f"provider request failed: {type(exc).__name__}.")
        return ""


if not provider_ready():
    raise SystemExit(0)

prompt = os.environ.get("ZYRA_PROMPT", "").strip()
if prompt:
    answer = ask([{"role": "user", "content": prompt}])
    zyra_print(answer if answer else "provider returned no text.")
    raise SystemExit(0)

print(f"{CYAN}ZYRA TALK MODE // ONLINE{RESET}")
print("Type /exit to return to the command core.")
history = []
while True:
    try:
        prompt = input(f"{CYAN}ZYRA > {RESET}").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        break
    if not prompt:
        continue
    if prompt.lower() in {"/exit", "exit", "/quit", "quit"}:
        break
    if prompt.lower() == "/clear":
        history.clear()
        zyra_print("memory cleared")
        continue
    history.append({"role": "user", "content": prompt})
    answer = ask(history)
    if answer:
        zyra_print(answer)
        history.append({"role": "assistant", "content": answer})
    else:
        zyra_print("provider returned no text.")
PY
