{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonoxo.dev/schemas/intelligence-record.schema.json",
  "title": "Zyra Public Intelligence Record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_id",
    "source",
    "classification",
    "ingested_at",
    "provenance",
    "confidence"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "classification": {
      "type": "string",
      "enum": ["PUBLIC", "PUBLIC/DECLASSIFIED", "PUBLIC/UNCLASSIFIED"]
    },
    "source": {
      "type": "object",
      "required": ["publisher", "url"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "published_at": { "type": ["string", "null"] },
        "document_id": { "type": ["string", "null"] }
      }
    },
    "ingested_at": { "type": "string" },
    "observed_at": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "entities": { "type": "array", "items": { "type": "object" } },
    "relationships": { "type": "array", "items": { "type": "object" } },
    "geometry": { "type": ["object", "null"] },
    "coordinate_reference_system": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": {
      "type": "object",
      "required": ["source_type", "transformations"],
      "properties": {
        "source_type": { "type": "string" },
        "transformations": { "type": "array", "items": { "type": "string" } },
        "derived_from": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
